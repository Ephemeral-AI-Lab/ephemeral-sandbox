#!/usr/bin/env python3

from __future__ import annotations

import os
import pathlib
import sys


def main() -> None:
    runner = pathlib.Path(__file__).with_name("run-mpla-booster-scorecard")
    os.execv(
        sys.executable,
        [
            sys.executable,
            str(runner),
            "--case",
            "sealing",
            *sys.argv[1:],
        ],
    )


if __name__ == "__main__":
    main()
